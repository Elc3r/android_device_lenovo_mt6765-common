allow { appdomain -isolated_app } vendor_proc_ged:file { getattr open read ioctl };
allow { bootanim hal_camera_default hal_graphics_allocator_default hal_graphics_composer_default mediacodec surfaceflinger system_server } vendor_proc_ged:file { getattr open read ioctl };

# libgralloc_extra uses the GE allocation/get/set/query contract (0x6764/65/66/69).
allowxperm { appdomain -isolated_app } vendor_proc_ged:file ioctl { 0x6700 0x6703 0x6704 0x6705 0x6709 0x670d 0x6764 0x6765 0x6766 0x6769 };
allowxperm bootanim vendor_proc_ged:file ioctl { 0x6704 0x6765 0x6766 };
allowxperm hal_camera_default vendor_proc_ged:file ioctl { 0x6765 0x6766 };
allowxperm hal_graphics_allocator_default vendor_proc_ged:file ioctl { 0x6764 0x6765 0x6766 };
allowxperm hal_graphics_composer_default vendor_proc_ged:file ioctl { 0x6701 0x6764 0x6765 0x6766 0x6769 };
allowxperm { mediacodec surfaceflinger system_server } vendor_proc_ged:file ioctl { 0x6765 };

allow hal_graphics_composer_default vendor_sysfs_boot_mode:file { getattr open read };
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket read;
allow hal_graphics_composer_default hal_allocator_server:fd use;
allow hal_graphics_composer_default hidl_memory_hwservice:hwservice_manager find;

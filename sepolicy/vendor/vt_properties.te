vendor_restricted_prop(vendor_vt_capability_prop)
get_prop(mtk_vt_vendor_config_reader, vendor_vt_capability_prop)
set_prop(vendor_init, vendor_vt_capability_prop)
neverallow { domain -init -vendor_init } vendor_vt_capability_prop:property_service set;
neverallow appdomain vendor_vt_capability_prop:file no_rw_file_perms;


hal_attribute(vendor_pq)

type vendor_pq, domain;
type vendor_pq_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_pq)
hal_server_domain(vendor_pq, hal_vendor_pq)
hal_client_domain(vendor_pq, hal_allocator)

hal_attribute_hwservice(hal_vendor_pq, vendor_pq_hwservice)
hal_client_domain(hal_graphics_composer_default, hal_vendor_pq)
hal_client_domain(hal_camera_default, hal_vendor_pq)
binder_call(hal_vendor_pq_client, hal_vendor_pq_server)

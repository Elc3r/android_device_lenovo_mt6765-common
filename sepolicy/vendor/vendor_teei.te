type vendor_teei, domain;
type vendor_teei_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_teei)

allow vendor_teei tee_device:chr_file { open read write };
allow vendor_teei vendor_teei_vfs_device:chr_file { open read write };
allow vendor_teei vendor_teei_config_device:chr_file { open read write ioctl };
allowxperm vendor_teei vendor_teei_config_device:chr_file ioctl { 0x5403 0x5404 };
allow vendor_teei vendor_rpmb_device:chr_file { open read write ioctl };
allowxperm vendor_teei vendor_rpmb_device:chr_file ioctl { 0x5 0x6 0x7 0x8 };

vendor_internal_prop(vendor_teei_init_prop)
set_prop(vendor_teei, vendor_teei_init_prop)
